{
  "name": "awrynn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An interactive neural network laboratory \u2014 a real feedforward network you can watch think and watch learn.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gradcheck": "vitest run src/engine/__tests__/gradcheck.test.ts",
    "typecheck": "npm run typecheck:engine && tsc -p tsconfig.json",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "lint": "eslint .",
    "headless": "vite-node scripts/headless.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "docs:lessons": "vite-node scripts/write-lessons-doc.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
